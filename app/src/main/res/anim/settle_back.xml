<?xml version="1.0" encoding="utf-8"?>
<!--
  The app easing back as the payment sheet covers it. A small scale and fade
  give the sheet something to sit in front of, rather than the app vanishing.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:interpolator="@android:interpolator/decelerate_quint">
    <scale
        android:fromXScale="1.0" android:toXScale="0.96"
        android:fromYScale="1.0" android:toYScale="0.96"
        android:pivotX="50%p" android:pivotY="50%p" />
    <alpha android:fromAlpha="1.0" android:toAlpha="0.85" />
</set>